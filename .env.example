# Внешний адрес, по которому сервер видят клиенты (обязательно HTTPS, кроме localhost).
PUBLIC_URL=https://mirea.example.com

# Ключ шифрования сессий МИРЭА. Пусто — сгенерируется в data/key при первом запуске.
# Сгенерировать вручную: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
SESSION_KEYS=

# Разрешить подключение без входа в МИРЭА (только публичное расписание).
ALLOW_GUEST=true

# Прокси для pulse.mirea.ru — нужен, если сервер в датацентре (МИРЭА их блокирует).
MIREA_PROXY=

# Токен Cloudflare Tunnel для профиля `tunnel` в docker-compose.
CLOUDFLARE_TUNNEL_TOKEN=
